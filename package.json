{
  "name": "@the-seeker/madefeed",
  "version": "0.7.0",
  "description": "MadeFeed 토큰 미터: AI 코딩 도구의 토큰 사용량 합계를 madefeed.dev 에 올려요.",
  "homepage": "https://madefeed.dev/meter",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coin-seeker/madefeed-meter.git"
  },
  "bugs": {
    "url": "https://github.com/coin-seeker/madefeed-meter/issues"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.15"
  },
  "bin": {
    "madefeed": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "esbuild src/bin.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/cli.mjs --banner:js=\"#!/usr/bin/env node\"",
    "typecheck": "tsrs --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "esbuild": "0.28.2",
    "tsrs": "0.24.0-ts7.1.0-beta",
    "vitest": "5.1.1"
  }
}
